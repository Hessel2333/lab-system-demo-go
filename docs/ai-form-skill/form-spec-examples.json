    {
      "formId": "procurement_batch_import_match",
      "scene": "采购导入-主子表批量匹配与确认（主子表+复杂校验）",
      "fields": [
        { "fieldId": "period", "label": "所属周期", "component": "native-input(type=month)", "valueType": "string" },
