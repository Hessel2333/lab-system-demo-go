        { "fieldId": "name", "label": "柜名", "component": "native-input", "valueType": "string", "required": true },
        { "fieldId": "cabinet_type", "label": "柜类型", "component": "segmented-buttons", "valueType": "enum", "required": true, "options": ["普通试剂柜", "易制毒制爆试剂柜"] },
