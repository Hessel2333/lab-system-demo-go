{
  "version": "0.1.0",
  "description": "Normalized FormSpec examples extracted from current repo",
  "examples": [
    {
      "formId": "instrument_create_dialog",
      "scene": "仪器台账-新增入库（简单录入）",
      "fields": [
        { "fieldId": "name", "label": "仪器名称", "component": "Input", "valueType": "string", "required": true },
        { "fieldId": "model", "label": "型号", "component": "Input", "valueType": "string", "required": true },
        { "fieldId": "brand", "label": "品牌/厂商", "component": "Input", "valueType": "string", "required": false },
        { "fieldId": "location", "label": "存放位置", "component": "Input", "valueType": "string", "required": false },
        { "fieldId": "status", "label": "初始状态", "component": "Select", "valueType": "enum", "required": true, "default": "active", "options": ["active", "arrival", "maintenance"] }
      ],
      "layout": { "type": "dialog", "size": "xl", "grid": "2列+1行状态" },
      "validations": [
        { "rule": "name 与 model 必填", "trigger": "submit", "level": "error", "implementation": "if (!form.name || !form.model) alert" }
      ],
      "linkages": [],
      "permissions": {
        "visibility": "未在组件内按角色限制",
        "readonlyRules": ["loading=true 时提交按钮禁用"]
      },
      "submitFlow": {
        "action": "createInstrument",
        "endpoint": "/api/instruments",
        "payloadTransform": "附加 purchase_date/admin/run_time/health/reservations_count/lifecycle_stage",
        "onSuccess": ["emit(success)", "emit(close)", "reset form"]
      },
      "evidencePaths": [
        "frontend/src/components/instruments/InstrumentCreationDialog.vue",
        "frontend/src/api/instruments.ts"
      ]
    },
    {
      "formId": "instrument_status_update_dialog",
      "scene": "仪器台账-状态变更（含只读字段）",
      "fields": [
        { "fieldId": "currentStatus", "label": "当前状态", "component": "readonly-text", "valueType": "string", "readonly": true },
        { "fieldId": "status", "label": "新状态", "component": "Select", "valueType": "enum", "options": ["active", "in_use", "maintenance", "fault", "retired"] },
        { "fieldId": "operator", "label": "操作员", "component": "Input", "valueType": "string" },
        { "fieldId": "reason", "label": "备注原因", "component": "Textarea", "valueType": "string" }
      ],
      "layout": { "type": "dialog", "size": "md", "grid": "单列" },
      "validations": [
        { "rule": "instrumentId 缺失时禁止提交", "trigger": "submit", "level": "error", "implementation": "if (!props.instrumentId) return" }
      ],
      "linkages": [],
      "permissions": {
        "visibility": "由上层页面控制弹窗触发",
        "readonlyRules": ["currentStatus 只读显示"]
      },
      "submitFlow": {
        "action": "updateInstrumentStatus",
        "endpoint": "/api/instruments/:id/status",
        "payload": ["status"],
        "onSuccess": ["emit(update)"]
      },
      "evidencePaths": [
        "frontend/src/components/instruments/StatusUpdateDialog.vue",
        "frontend/src/api/instruments.ts"
      ]
    },
    {
      "formId": "instrument_arrival_wizard",
      "scene": "仪器采购-到货验收向导（多步表单）",
      "fields": [
        { "fieldId": "packaging", "label": "外观包装", "component": "card-radio", "valueType": "enum", "options": ["intact", "damaged"], "default": "intact" },
        { "fieldId": "photo", "label": "包装照片", "component": "upload-placeholder", "valueType": "file|null" },
        { "fieldId": "checklist.host", "label": "主机设备", "component": "native-checkbox", "valueType": "boolean" },
        { "fieldId": "checklist.powerCord", "label": "电源线/数据线", "component": "native-checkbox", "valueType": "boolean" },
        { "fieldId": "checklist.manual", "label": "说明书/保修卡", "component": "native-checkbox", "valueType": "boolean" },
        { "fieldId": "assetNo", "label": "资产编号", "component": "Input", "valueType": "string", "readonly": true },
        { "fieldId": "sn", "label": "序列号", "component": "Input", "valueType": "string" },
        { "fieldId": "location", "label": "存放位置", "component": "Input", "valueType": "string" }
      ],
      "layout": { "type": "step-dialog", "steps": ["外观检查", "配件核对", "资产登记"] },
      "validations": [],
      "linkages": [
        { "trigger": "step", "target": "表单区块", "effect": "step 变化切换不同字段组" }
      ],
      "permissions": {
        "visibility": "由采购看板触发",
        "readonlyRules": ["assetNo 自动生成且禁用编辑"]
      },
      "submitFlow": {
        "action": "emit(complete, form)",
        "endpoint": "上层组件处理",
        "onSuccess": ["父组件更新状态并关闭弹窗"]
      },
      "evidencePaths": [
        "frontend/src/components/instruments/ArrivalWizard.vue",
        "frontend/src/components/instruments/InstrumentProcurement.vue"
      ]
    },
    {
      "formId": "instrument_reservation_calendar_create",
      "scene": "仪器预约-拖拽时段创建（动态联动）",
      "fields": [
        { "fieldId": "selectedSlot.start", "label": "开始时间", "component": "drag-selection", "valueType": "datetime", "readonly": true },
        { "fieldId": "selectedSlot.end", "label": "结束时间", "component": "drag-selection", "valueType": "datetime", "readonly": true },
        { "fieldId": "newReservationForm.project", "label": "实验项目名称", "component": "Input", "valueType": "string" },
        { "fieldId": "newReservationForm.description", "label": "备注说明", "component": "Input", "valueType": "string" }
      ],
      "layout": { "type": "calendar+dialog", "grid": "周视图拖拽 + 弹窗确认" },
      "validations": [
        { "rule": "selectedSlot 与 instrumentId 必须存在", "trigger": "confirmReservation", "level": "error", "implementation": "if (!selectedSlot || !instrumentId) return" }
      ],
      "linkages": [
        { "trigger": "mousedown/mouseenter/mouseup", "target": "selectedSlot", "effect": "拖拽生成时间区间并打开新建弹窗" },
        { "trigger": "watch(startOfWeek, instrumentId)", "target": "reservations", "effect": "自动重载当前周预约" }
      ],
      "permissions": {
        "visibility": "全部角色可创建；取消按钮仅当前用户预约可见",
        "readonlyRules": ["详情弹窗中他人预约仅查看"]
      },
      "submitFlow": {
        "action": "createReservation",
        "endpoint": "/api/reservations",
        "payload": ["instrument_id", "start_time", "end_time", "type", "description"],
        "onSuccess": ["关闭弹窗", "重新加载周数据"]
      },
      "evidencePaths": [
        "frontend/src/components/instruments/InstrumentReservationCalendar.vue",
        "frontend/src/api/reservations.ts"
      ]
    },
    {
      "formId": "user_dialog",
      "scene": "组织管理-成员新增/编辑（基础维护）",
      "fields": [
        { "fieldId": "real_name", "label": "真实姓名", "component": "native-input", "valueType": "string", "required": true },
        { "fieldId": "username", "label": "工号/用户名", "component": "native-input", "valueType": "string", "required": true },
        { "fieldId": "role", "label": "角色", "component": "Select", "valueType": "enum", "default": "member" },
        { "fieldId": "department_id", "label": "所属组织", "component": "Select", "valueType": "number", "required": true }
      ],
      "layout": { "type": "dialog", "size": "md", "grid": "单列" },
      "validations": [
        { "rule": "real_name、username 使用 required", "trigger": "native form submit", "level": "error", "implementation": "HTML required" }
      ],
      "linkages": [
        { "trigger": "watch(modelValue)", "target": "formData", "effect": "根据 editUser 切换新增默认值/编辑回填" },
        { "trigger": "departments 变化", "target": "departmentOptions", "effect": "树结构扁平化为可选项" }
      ],
      "permissions": {
        "visibility": "由 UserManagement 页面触发",
        "readonlyRules": []
      },
      "submitFlow": {
        "action": "emit(submit)",
        "endpoint": "由父组件调用 /api/users POST|PUT",
        "onSuccess": ["父组件刷新组织用户列表"]
      },
      "evidencePaths": [
        "frontend/src/components/organization/UserDialog.vue",
        "frontend/src/views/UserManagement.vue",
        "frontend/src/api/organization.ts"
      ]
    },
    {
      "formId": "dual_sign_policy_form",
      "scene": "权限策略中心-A/B 钥匙持有人配置（权限场景）",
      "fields": [
        { "fieldId": "selectedAId", "label": "A角持有人", "component": "native-select", "valueType": "number|null", "required": true },
        { "fieldId": "selectedBId", "label": "B角持有人", "component": "native-select", "valueType": "number|null", "required": true }
      ],
      "layout": { "type": "page-card", "grid": "2列卡片" },
      "validations": [
        { "rule": "A/B 必须都已选择", "trigger": "saveDualSignHolders", "level": "error", "implementation": "if (!selectedAId || !selectedBId) toast.error" },
        { "rule": "A/B 不能同一人", "trigger": "saveDualSignHolders", "level": "error", "implementation": "if (selectedAId===selectedBId) toast.error" }
      ],
      "linkages": [
        { "trigger": "loadUsersData", "target": "selectedAId/selectedBId", "effect": "根据用户当前标记自动回填" },
        { "trigger": "save", "target": "users[]", "effect": "按差异批量更新用户双签权限" }
      ],
      "permissions": {
        "visibility": "全局策略页（非单用户弹窗）",
        "readonlyRules": ["成员双签映射表仅查看"]
      },
      "submitFlow": {
        "action": "updateUserReagentPermissions (批量 Promise.all)",
        "endpoint": "/api/users/:id/reagent-permissions",
        "onSuccess": ["toast.success", "重新加载用户数据"]
      },
      "evidencePaths": [
        "frontend/src/views/UserPermissionSettings.vue",
        "frontend/src/api/organization.ts"
      ]
    },
    {
      "formId": "reagent_request_wizard",
      "scene": "试剂申购-AI解析+手工修正（动态字段、远程联动）",
      "fields": [
        { "fieldId": "prompt", "label": "自然语言申购描述", "component": "native-textarea", "valueType": "string" },
        { "fieldId": "name", "label": "试剂名称", "component": "Input", "valueType": "string", "required": true },
        { "fieldId": "cas_number", "label": "CAS 编号", "component": "Input", "valueType": "string" },
        { "fieldId": "quantity", "label": "申购数量", "component": "Input", "valueType": "number", "required": true },
        { "fieldId": "unit", "label": "包装规格/单位", "component": "Input", "valueType": "string" },
        { "fieldId": "is_controlled", "label": "易制毒/易制爆", "component": "Switch", "valueType": "boolean" },
        { "fieldId": "request_type", "label": "需求类型", "component": "segmented-buttons", "valueType": "enum", "options": ["日常", "储备", "紧急"] },
        { "fieldId": "expected_delivery", "label": "要求交期", "component": "Input(type=date)", "valueType": "date" },
        { "fieldId": "project_name", "label": "所属项目", "component": "Input", "valueType": "string" },
        { "fieldId": "project_id", "label": "项目编号", "component": "Input", "valueType": "string" },
        { "fieldId": "remarks", "label": "用途说明", "component": "Input", "valueType": "string" }
      ],
      "layout": { "type": "two-column-page", "left": "主表单", "right": "库存状态+快捷回填" },
      "validations": [
        { "rule": "name 与 quantity 必填", "trigger": "submitRequest", "level": "error", "implementation": "if (!name || !quantity) toast.error" },
        { "rule": "prompt 为空禁止 AI 解析", "trigger": "analyzeRequest", "level": "warning", "implementation": "if (!prompt.trim()) return" }
      ],
      "linkages": [
        { "trigger": "watch(cas_number/name)", "target": "stockInfo", "effect": "600ms 防抖查询库存" },
        { "trigger": "stockInfo.catalog 存在", "target": "is_controlled", "effect": "自动回填并禁用开关" },
        { "trigger": "AI parse 成功", "target": "formFields", "effect": "结构化回填字段" },
        { "trigger": "quickFill", "target": "formFields", "effect": "常用/复购模板回填" }
      ],
      "permissions": {
        "visibility": "研发侧 tab",
        "readonlyRules": ["库存命中时管控开关禁用"]
      },
      "submitFlow": {
        "action": "find-or-create catalog -> create request",
        "endpoints": ["/api/reagents/catalogs", "/api/reagents/requests"],
        "payloadTransform": "优先复用同名/CAS 品目，否则新建后再提交申购",
        "onSuccess": ["emit(request-submitted)", "resetForm", "刷新复购记录"]
      },
      "evidencePaths": [
        "frontend/src/components/reagents/ReagentRequestWizard.vue"
      ]
    },
    {
      "formId": "reagent_catalog_edit_dialog",
      "scene": "主数据中心-试剂品目编辑（复杂字段组合）",
